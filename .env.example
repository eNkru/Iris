# ---------------------------------------------------------------------------
# Iris — price tracking & alert app
# Copy to .env and adjust. Secrets are never committed.
# ---------------------------------------------------------------------------

# App
NODE_ENV=development
APP_URL=http://localhost:3000

# better-auth session signing secret — generate a long random value
# (e.g. `openssl rand -base64 32`) and ALWAYS override this in production
BETTER_AUTH_SECRET=dev-secret-change-me

# Database (PostgreSQL)
# Local dev: point at your own Postgres. docker-compose.yml builds this URL
# from POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB for the `app` service.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/iris

# Docker Compose — Postgres container credentials. Only used by
# docker-compose.yml (POSTGRES_* env for the `postgres` service and to derive
# the in-container DATABASE_URL); ignored by the app itself.
POSTGRES_USER=iris
POSTGRES_PASSWORD=iris
POSTGRES_DB=iris

# Redis (session cache, scheduler lock)
REDIS_URL=redis://localhost:6379

# SMTP — required for magic-link login emails (and future email alert channel)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@localhost

# AI (OpenAI-compatible) — generic endpoint. Instance-level config (base URL,
# API key, model) is admin-editable at runtime; these are build-time fallbacks
# used for seeding / first boot. Point at any OpenAI-compatible service:
# OpenAI, OpenRouter, OpenCode Zen, a local Llama/Ollama server, etc.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Telegram alert channel
TELEGRAM_BOT_TOKEN=

# Scheduler — how often the in-process loop looks for due products, and the
# Redis distributed-lock TTL (seconds) so concurrent app replicas don't
# double-process the same product
SCHEDULER_TICK_MS=30000
SCHEDULER_LOCK_TTL_SECONDS=60

# Camoufox sidecar — the single fetch transport (required in every env).
# The sidecar runs the anti-detect Firefox browser that reads product pages
# behind hard anti-bot challenges (DataDome / Cloudflare / Akamai). It is a
# required dependency: the app boots only when this is set and the sidecar is
# reachable (AC5). Local dev: run the sidecar before starting the app —
# `docker compose up camoufox` (or a local venv). Default for local dev when
# running both via docker compose is http://camoufox:8000.
CAMOUFOX_SIDECAR_URL=http://localhost:8000
