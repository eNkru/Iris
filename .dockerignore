# Dependencies — `**/` anchors are required so nested workspace node_modules
# (packages/auth, apps/web, etc.) are excluded too. A bare `node_modules` only
# excludes the repo root; the nested pnpm symlinks it leaves behind would get
# COPY'd over the image's pnpm-installed symlinks. pnpm's virtual-store dir
# names carry an environment-specific hash, so the host symlinks point at a
# `.pnpm/<pkg>@<ver>__<hash>` path that does not exist in the container,
# breaking bare-import resolution (e.g. `better-auth/react`) at vite build.
**/node_modules
node_modules
.pnpm-store
**/.pnpm-store

# Local SQLite data
data

# Build outputs — anchored with **/ so nested copies are excluded too. A bare
# pattern like `.next` matches only the repo root, so a local dev build under
# apps/web/.next (often hundreds of MB) or packages/*/dist would otherwise
# ride into the image context and get COPY'd in.
**/.next
**/out
**/dist
**/build
**/*.tsbuildinfo

# Environment & secrets — never bake into the image
.env
.env.*.local

# Git
.git
.gitignore

# Local tooling / editor / OS
.idea
.vscode
.opencode
.claude
.agents
.DS_Store
*.log

# Unrelated stale scaffolding / validation artifacts — nothing the image needs
tmall-poc

# Trellis task artifacts (not needed in the image)
.trellis

# Docker build metadata
.dockerignore
